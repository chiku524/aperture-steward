{
  "version": "0.1",
  "type": "container",
  "meta": {
    "trigger": "deployment-manager",
    "system_requirements": { "vram_total_mb": 9216 }
  },
  "global": { "variables": { "MODEL": "qwen3.5:9b" } },
  "ops": [
    {
      "type": "container/run",
      "id": "llm",
      "args": {
        "image": "docker.io/ollama/ollama:0.31.2",
        "expose": [
          {
            "port": 11434,
            "health_checks": [
              {
                "type": "http",
                "path": "/api/tags",
                "method": "GET",
                "expected_status": 200,
                "continuous": false
              }
            ]
          }
        ],
        "gpu": true,
        "resources": [{ "type": "Ollama", "model": "qwen3.5:9b" }]
      },
      "execution": { "group": "run" }
    },
    {
      "type": "container/run",
      "id": "agent",
      "args": {
        "image": "ghcr.io/chiku524/aperture-steward-agent:latest",
        "expose": 3000,
        "env": {
          "OPENAI_API_KEY": "ollama",
          "OPENAI_BASE_URL": "http://127.0.0.1:11434/v1",
          "OPENAI_API_URL": "http://127.0.0.1:11434/v1",
          "MODEL_NAME": "qwen3.5:9b",
          "OPENAI_SMALL_MODEL": "qwen3.5:9b",
          "OPENAI_LARGE_MODEL": "qwen3.5:9b",
          "LARGE_MODEL": "qwen3.5:9b",
          "SMALL_MODEL": "qwen3.5:9b",
          "OPENAI_EMBEDDING_URL": "http://127.0.0.1:11434/v1",
          "OPENAI_EMBEDDING_API_KEY": "ollama",
          "OPENAI_EMBEDDING_MODEL": "qwen3.5:9b",
          "OPENAI_EMBEDDING_DIMENSIONS": "4096",
          "SERVER_PORT": "3000",
          "NODE_ENV": "production",
          "ATTENTION_BUDGET_LEVEL": "normal",
          "SOVEREIGNTY_MODE": "strict",
          "USE_OLLAMA_NATIVE": "1"
        }
      },
      "execution": { "group": "run" }
    }
  ]
}
